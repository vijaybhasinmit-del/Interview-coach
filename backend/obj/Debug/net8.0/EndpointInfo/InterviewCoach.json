{
  "openapi": "3.0.1",
  "info": {
    "title": "InterviewCoach",
    "version": "1.0"
  },
  "paths": {
    "/api/interview/start": {
      "post": {
        "tags": [
          "Interview"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/interview/answer": {
      "post": {
        "tags": [
          "Interview"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitAnswerResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitAnswerResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitAnswerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/interview/{sessionId}": {
      "delete": {
        "tags": [
          "Interview"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/interview/models": {
      "get": {
        "tags": [
          "Interview"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/interview/start-form": {
      "post": {
        "tags": [
          "Interview"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "ResumeText": {
                    "type": "string"
                  },
                  "ResumeFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "JobDescriptionText": {
                    "type": "string"
                  },
                  "JobDescriptionFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "CandidateName": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "ResumeText": {
                  "style": "form"
                },
                "ResumeFile": {
                  "style": "form"
                },
                "JobDescriptionText": {
                  "style": "form"
                },
                "JobDescriptionFile": {
                  "style": "form"
                },
                "CandidateName": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "InterviewCoach"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScoreCard": {
        "type": "object",
        "properties": {
          "overall": {
            "type": "integer",
            "format": "int32"
          },
          "categories": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "improvements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "verdict": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StartSessionRequest": {
        "type": "object",
        "properties": {
          "resume": {
            "type": "string",
            "nullable": true
          },
          "jobDescription": {
            "type": "string",
            "nullable": true
          },
          "candidateName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StartSessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "nullable": true
          },
          "firstQuestion": {
            "type": "string",
            "nullable": true
          },
          "totalQuestions": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SubmitAnswerRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "nullable": true
          },
          "answer": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SubmitAnswerResponse": {
        "type": "object",
        "properties": {
          "feedback": {
            "type": "string",
            "nullable": true
          },
          "nextQuestion": {
            "type": "string",
            "nullable": true
          },
          "questionNumber": {
            "type": "integer",
            "format": "int32"
          },
          "totalQuestions": {
            "type": "integer",
            "format": "int32"
          },
          "isComplete": {
            "type": "boolean"
          },
          "scoreCard": {
            "$ref": "#/components/schemas/ScoreCard"
          }
        },
        "additionalProperties": false
      }
    }
  }
}