using InterviewCoach.Models;
using InterviewCoach.Services;
using Microsoft.AspNetCore.Mvc;

namespace InterviewCoach.Controllers;

[ApiController]
[Route("api/interview")]
public class InterviewController : ControllerBase
{
    private readonly ClaudeService _claude;
    private readonly SessionStore _store;
    private readonly ILogger<InterviewController> _logger;

    public InterviewController(
        ClaudeService claude,
        SessionStore store,
        ILogger<InterviewController> logger)
    {
        _claude = claude;
        _store = store;
        _logger = logger;
    }

    // ── POST /api/interview/start ──────────────────────────────────────────────
    /// <summary>
    /// Creates a new interview session, returns the first question.
    /// </summary>
    [HttpPost("start")]
    public async Task<ActionResult<StartSessionResponse>> Start(
        [FromBody] StartSessionRequest req)
    {
        if (string.IsNullOrWhiteSpace(req.Resume) ||
            string.IsNullOrWhiteSpace(req.JobDescription))
            return BadRequest("Resume and JobDescription are required.");

        var session = _store.Create(req.Resume, req.JobDescription, req.CandidateName);

        try
        {
            var firstQuestion = await _claude.GetFirstQuestionAsync(session);
            _logger.LogInformation("Session {Id} started", session.Id);

            return Ok(new StartSessionResponse(
                SessionId: session.Id,
                FirstQuestion: firstQuestion,
                TotalQuestions: session.TotalQuestions
            ));
        }
        catch (Exception ex)
        {
            _store.Remove(session.Id);
            _logger.LogError(ex, "Failed to start session");
            return StatusCode(500, "Failed to contact AI service.");
        }
    }

    // ── POST /api/interview/answer ─────────────────────────────────────────────
    /// <summary>
    /// Submits an answer; returns AI feedback + next question (or scorecard).
    /// </summary>
    [HttpPost("answer")]
    public async Task<ActionResult<SubmitAnswerResponse>> Answer(
        [FromBody] SubmitAnswerRequest req)
    {
        var session = _store.Get(req.SessionId);
        if (session is null)
            return NotFound("Session not found or expired.");

        if (string.IsNullOrWhiteSpace(req.Answer))
            return BadRequest("Answer cannot be empty.");

        try
        {
            var (raw, isComplete, card) =
                await _claude.EvaluateAnswerAsync(session, req.Answer);

            // Strip the JSON block + INTERVIEW_COMPLETE token from visible text
            var visibleText = raw
                .Replace("INTERVIEW_COMPLETE", "")
                .ReplaceLineEndings("\n");

            var jsonBlockStart = visibleText.IndexOf("```json", StringComparison.Ordinal);
            if (jsonBlockStart > 0)
                visibleText = visibleText[..jsonBlockStart].Trim();

            // Split feedback (first 2 lines) from next question (rest)
            var lines = visibleText.Split('\n',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var feedbackLines = lines.Where(l =>
                l.StartsWith("✅") || l.StartsWith("⚠️")).ToList();
            var feedback = string.Join("\n", feedbackLines);

            var nextQuestion = isComplete
                ? null
                : string.Join("\n", lines.Except(feedbackLines));

            if (isComplete) _store.Remove(session.Id);

            return Ok(new SubmitAnswerResponse(
                Feedback: feedback,
                NextQuestion: nextQuestion,
                QuestionNumber: session.QuestionNumber,
                TotalQuestions: session.TotalQuestions,
                IsComplete: isComplete,
                ScoreCard: card
            ));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error evaluating answer for session {Id}", req.SessionId);
            return StatusCode(500, "Failed to evaluate answer.");
        }
    }

    // ── DELETE /api/interview/{sessionId} ─────────────────────────────────────
    [HttpDelete("{sessionId}")]
    public IActionResult Abandon(string sessionId)
    {
        _store.Remove(sessionId);
        return NoContent();
    }

    // ── GET /api/interview/models ─────────────────────────────────────────────
    /// <summary>
    /// Lists available models from the Generative Language API (raw JSON).
    /// Useful for inspecting supported model names and methods.
    /// </summary>
    [HttpGet("models")]
    public async Task<IActionResult> ListModels()
    {
        try
        {
            var json = await _claude.ListModelsAsync();
            return Content(json, "application/json");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to list models from AI service");
            return StatusCode(500, "Failed to list models.");
        }
    }

    // ── POST /api/interview/start-form ────────────────────────────────────────
    /// <summary>
    /// Accepts multipart/form-data where resume and job description can be
    /// provided as either plain text fields or PDF file uploads.
    /// </summary>
    [HttpPost("start-form")]
    [DisableRequestSizeLimit]
    public async Task<ActionResult<StartSessionResponse>> StartForm([FromForm] StartSessionForm form)
    {
        string resumeText = form.ResumeText ?? string.Empty;
        string jdText = form.JobDescriptionText ?? string.Empty;

        try
        {
            if (form.ResumeFile is not null && resumeText.Length == 0)
                resumeText = await ExtractTextFromPdfAsync(form.ResumeFile);

            if (form.JobDescriptionFile is not null && jdText.Length == 0)
                jdText = await ExtractTextFromPdfAsync(form.JobDescriptionFile);

            if (string.IsNullOrWhiteSpace(resumeText) || string.IsNullOrWhiteSpace(jdText))
                return BadRequest("Resume and JobDescription are required (text or PDF).");

            var session = _store.Create(resumeText, jdText, form.CandidateName ?? "");

            var firstQuestion = await _claude.GetFirstQuestionAsync(session);
            _logger.LogInformation("Session {Id} started via form", session.Id);

            return Ok(new StartSessionResponse(
                SessionId: session.Id,
                FirstQuestion: firstQuestion,
                TotalQuestions: session.TotalQuestions
            ));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to start session (form)");
            return StatusCode(500, "Failed to start session.");
        }
    }

    private static async Task<string> ExtractTextFromPdfAsync(IFormFile file)
    {
        using var ms = new MemoryStream();
        await file.CopyToAsync(ms);
        ms.Position = 0;

        using var doc = UglyToad.PdfPig.PdfDocument.Open(ms);
        var sb = new StringBuilder();
        foreach (var page in doc.GetPages())
        {
            sb.AppendLine(page.Text);
        }

        return sb.ToString();
    }
}
